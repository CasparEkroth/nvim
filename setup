#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NVIM_CONFIG_DIR="$HOME/.config/nvim"
NVIM_DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/nvim"
NVIM_VENV="$NVIM_DATA_DIR/venv"
NVIM_MIN="0.10"
IMAGES=auto

for arg in "$@"; do
  case "$arg" in
    --no-images) IMAGES=0 ;;
    --images)    IMAGES=1 ;;
  esac
done

# Colors only when writing to a terminal
if [[ -t 1 ]]; then
  YELLOW=$'\033[1;33m'; BOLD=$'\033[1m'; RESET=$'\033[0m'
else
  YELLOW=""; BOLD=""; RESET=""
fi

if ! command -v nvim >/dev/null 2>&1; then
    echo "Neovim is not installed (need >= $NVIM_MIN)." >&2
    exit 1
fi

nvim_ver="$(nvim --version | sed -n '1s/.*v\([0-9]*\.[0-9]*\).*/\1/p' || true)"
if [[ -z "$nvim_ver" ]] || [[ "$(printf '%s\n%s\n' "$NVIM_MIN" "$nvim_ver" | sort -V | head -n1)" != "$NVIM_MIN" ]]; then
    echo "Neovim >= $NVIM_MIN required, found: ${nvim_ver:-unknown} ($(command -v nvim))" >&2
    echo "  Linux: grab the tarball from https://github.com/neovim/neovim/releases/latest" >&2
    echo "         (apt is too old), symlink it to /usr/local/bin/nvim" >&2
    echo "  macOS: brew install neovim" >&2
    exit 1
fi
echo "Neovim $nvim_ver OK."

mkdir -p "$NVIM_CONFIG_DIR"
mkdir -p "$NVIM_DATA_DIR"

if [[ "$IMAGES" == 0 ]]; then
  touch "$NVIM_DATA_DIR/no-images"
elif [[ "$IMAGES" == 1 ]]; then
  rm -f "$NVIM_DATA_DIR/no-images"
fi

# Sync the full modular config (preserves structure, removes stale files)
rsync -a --delete \
  --exclude '.git' \
  --exclude '.gitignore' \
  --exclude 'setup' \
  --exclude '.DS_Store' \
  --exclude '.clang-format' \
  "$SCRIPT_DIR/" "$NVIM_CONFIG_DIR/"

# clang-format walks upward from any C/C++ file toward the filesystem root
# looking for .clang-format, so installing one at $HOME applies it to every
# project (clangd's --fallback-style flag is unreliable, so we don't use it)
cp "$SCRIPT_DIR/.clang-format" "$HOME/.clang-format"

# ---------------------------------------------------------------------------
# Python host env for molten-nvim / jupytext (pynvim remote plugin + kernels)
# Prefer a real 3.10+ interpreter (Homebrew on Mac); avoid macOS system 3.9.
# ---------------------------------------------------------------------------
pick_python() {
  local c
  for c in \
    "${MOLTEN_PYTHON:-}" \
    python3.14 python3.13 python3.12 python3.11 python3.10 \
    /opt/homebrew/bin/python3 \
    /usr/local/bin/python3 \
    python3
  do
    [[ -z "$c" ]] && continue
    if command -v "$c" >/dev/null 2>&1; then
      if "$c" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
        command -v "$c"
        return 0
      fi
    fi
  done
  return 1
}

if PY="$(pick_python)"; then
  # Ctrl-C during `python -m venv` can leave a half-created tree without a working pip.
  venv_usable() {
    [[ -x "$NVIM_VENV/bin/python" && -x "$NVIM_VENV/bin/pip" ]] \
      || [[ -x "$NVIM_VENV/Scripts/python.exe" && -x "$NVIM_VENV/Scripts/pip.exe" ]]
  }

  if venv_usable; then
    echo "Neovim Python venv already exists at $NVIM_VENV"
  else
    if [[ -e "$NVIM_VENV" ]]; then
      echo "Removing incomplete venv at $NVIM_VENV"
      rm -rf "$NVIM_VENV"
    fi
    echo "Creating Neovim Python venv at $NVIM_VENV (interpreter: $PY)"
    "$PY" -m venv "$NVIM_VENV"
  fi

  if [[ -x "$NVIM_VENV/bin/python" ]]; then
    VENV_PY="$NVIM_VENV/bin/python"
    VENV_PIP="$NVIM_VENV/bin/pip"
  else
    VENV_PY="$NVIM_VENV/Scripts/python.exe"
    VENV_PIP="$NVIM_VENV/Scripts/pip.exe"
  fi

  if ! venv_usable; then
    echo "ERROR: venv exists but pip is missing at $NVIM_VENV" >&2
    echo "  rm -rf \"$NVIM_VENV\" && re-run ./setup" >&2
    exit 1
  fi

  # Keep pip output visible — first install often takes 1–3 minutes and looked "stuck"
  # when redirected to /dev/null.
  echo "Upgrading pip ..."
  "$VENV_PIP" install --upgrade pip
  echo "Installing Python host packages (pynvim, jupyter, jupytext, openpyxl, ...) ..."
  "$VENV_PIP" install --upgrade \
    pynvim \
    jupyter_client \
    ipykernel \
    jupytext \
    nbformat \
    pillow \
    openpyxl

  # Register a default kernel so :MoltenInit has something to attach to
  echo "Registering Jupyter kernel 'nvim' ..."
  "$VENV_PY" -m ipykernel install --user --name=nvim --display-name="Neovim (molten)" || true

  echo "Python host packages installed for molten/jupytext."
  echo "  vim.g.python3_host_prog -> $VENV_PY"
else
  echo "WARNING: No Python >= 3.10 found. Install one, then re-run ./setup." >&2
  echo "  molten-nvim needs: pynvim jupyter_client ipykernel jupytext" >&2
fi

# ImageMagick is required by image.nvim (magick_cli processor) for plot rendering
if [[ -f "$NVIM_DATA_DIR/no-images" ]]; then
  echo "Inline images: ${BOLD}disabled${RESET} (re-enable with ./setup --images)"
else
  if ! command -v magick >/dev/null 2>&1 && ! command -v convert >/dev/null 2>&1; then
    echo "${YELLOW}NOTE:${RESET} ImageMagick not found. Inline plot rendering needs it:"
    echo "  macOS:  ${BOLD}brew install imagemagick${RESET}"
    echo "  Ubuntu: ${BOLD}sudo apt install imagemagick${RESET}"
  fi
  if [[ -n "${SSH_TTY:-}" ]]; then
    echo "${YELLOW}NOTE:${RESET} you're on SSH, inline images can't render here."
    echo "  Skip image.nvim with: ${BOLD}./setup --no-images${RESET}"
  fi
fi

# lazy.nvim's luarocks support builds Lua 5.1 from source (hererocks), which
# needs a C toolchain, the readline headers and unzip. Missing on fresh servers.
if [[ "$(uname -s)" == "Linux" ]]; then
  missing_pkgs=()
  [[ -f /usr/include/readline/readline.h ]] || missing_pkgs+=(libreadline-dev)
  if ! command -v gcc >/dev/null 2>&1 || ! command -v make >/dev/null 2>&1; then
    missing_pkgs+=(build-essential)
  fi
  command -v unzip >/dev/null 2>&1 || missing_pkgs+=(unzip)

  if (( ${#missing_pkgs[@]} > 0 )); then
    echo "${YELLOW}NOTE:${RESET} missing build deps for luarocks/hererocks (plugin builds will fail):"
    echo "  Ubuntu: ${BOLD}sudo apt install ${missing_pkgs[*]}${RESET}"
  fi
fi

echo
echo "nvim config installed to $NVIM_CONFIG_DIR"
echo "clang-format style (4-space indent) installed to $HOME/.clang-format"
echo "Open nvim to let lazy.nvim finish plugin setup, then run :UpdateRemotePlugins once if needed."
echo
echo "Jupyter / image notes:"
echo "  - Open .ipynb files normally; jupytext.nvim converts them to hydrogen (# %%) python."
echo "  - Keymaps (leader = space): ji init, jc run cell, jn run+next, jv visual,"
echo "    jo open output, jh hide output, jr restart kernel."
echo "  - Inline images need Kitty/Ghostty/WezTerm (Kitty graphics protocol)."
echo "    Apple Terminal cannot render them; molten text output still works."
echo "  - WSL: image.nvim is limited — install ueberzugpp under WSLg, or use text-only output."
echo
echo "Xlsx notes:"
echo "  - Open .xlsx files normally; shown as an aligned table (openpyxl, via the venv)."
echo "  - ]s / [s cycle sheets. o/O rows, <leader>c/C columns, :w saves changed cells only."
